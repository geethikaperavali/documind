# ==============================================================================
# DOCUMIND ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your actual credentials.
# Never commit .env with real secrets to version control.
# ==============================================================================

# Supabase Project Credentials
# Obtain from Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-optional

# Google Gemini AI API Key
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-placeholder
GEMINI_MODEL=gemini-2.0-flash

# Server Configuration
HOST=0.0.0.0
PORT=8000

# RAG & Document Processing Settings
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MAX_FILE_SIZE_BYTES=26214400
